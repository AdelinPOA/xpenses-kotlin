#!/usr/bin/env bash
# .githooks/pre-commit
# Automatically reconciles bounded telemetry in README.md and runs fast drift/parity checks.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[*] Xpenses Pre-Commit: Reconciling README telemetry..."
python3 scripts/reconcile.py reconcile

# Stage README.md if reconcile updated it so changes land atomically
git add -u "README.md" 2>/dev/null || true

echo "[*] Xpenses Pre-Commit: Running fast audit..."
if ! python3 scripts/reconcile.py audit; then
    echo ""
    echo "❌ COMMIT REJECTED: Audit failed. Fix the issues above before committing."
    echo ""
    exit 1
fi

echo "✅ Pre-commit reconciliation & audit passed."
exit 0
