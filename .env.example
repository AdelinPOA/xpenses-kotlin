# Security
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars-long
ENCRYPTION_SECRET=your-secure-random-encryption-secret-key-at-least-32-chars-long
COOKIE_SECURE=false

# Seeding & Initial Config
# Set to 'false' in production so demo credentials are not created
SEED_DEMO_USERS=false
COMPANY_NAME=XPenses Ltd.

# Network Binding (Default to 127.0.0.1 for secure reverse-proxy routing)
BACKEND_BIND_IP=127.0.0.1
FRONTEND_BIND_IP=127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Storage
DATA_DIR=/app/data
DEFAULT_CURRENCY=EUR

# Database (Used by docker-compose templating)
DB_USER=xpenses
DB_PASSWORD=xpenses
DB_NAME=xpenses

# Environment Profiles & API Documentation
# Set to 'prod' in production to enable structured JSON logging
SPRING_PROFILES_ACTIVE=dev
# Set to 'false' in production to disable the public Swagger/OpenAPI UI
SWAGGER_ENABLED=true

# Frontend Dual-API URLs
NEXT_PUBLIC_API_URL=http://localhost:8001/api
INTERNAL_API_URL=http://backend:8080/api
# Build-time flag for the staged single-receipt capture/review experience.
NEXT_PUBLIC_OCR_IMMEDIATE_REVIEW_ENABLED=false

