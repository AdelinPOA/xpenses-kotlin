{
  "name": "xpenses-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test:lint-config": "node --test tests/tooling/eslint-coverage.test.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node ../scripts/check-i18n-parity.mjs",
    "test:auth:unit": "node --experimental-strip-types --test tests/auth/auth-session.test.mjs",
    "test:mileage:unit": "node --experimental-strip-types --test tests/reports/mileage-weeks.test.mjs",
    "test:auth-regressions": "npm run test:auth:unit && INTERNAL_API_URL=http://127.0.0.1:18081/api PLAYWRIGHT_PORT=3101 playwright test tests/auth/token-refresh.spec.ts --project=mobile-chromium --workers=1 --reporter=list",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test tests/mobile-ui.spec.ts tests/auth/login-hydration.spec.ts --project=mobile-chromium --project=mobile-webkit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.469.0",
    "next": "16.4.6",
    "next-intl": "^4.13.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.8.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "follow-redirects": "^1.16.3",
    "minimatch": "^11.0.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.5"
  }
}
