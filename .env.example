# Security
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars-long
COOKIE_SECURE=false

# Seeding & Initial Config
SEED_DEMO_USERS=true
COMPANY_NAME=XPenses Ltd.

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Storage
DATA_DIR=/app/data
DEFAULT_CURRENCY=EUR

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://xpenses-db:5432/xpenses
SPRING_DATASOURCE_USERNAME=xpenses
SPRING_DATASOURCE_PASSWORD=xpenses

# Frontend Dual-API URLs
NEXT_PUBLIC_API_URL=http://localhost:8001/api
INTERNAL_API_URL=http://backend:8080/api
