      "name": "findAllWithExpenses",
      "signature": "public abstract java.util.List<eu.nt.xpenses.models.Report> eu.nt.xpenses.repositories.ReportRepository.findAllWithExpenses()",
      "query": {
        "query": "SELECT DISTINCT r FROM Report r LEFT JOIN FETCH r.expenses"
      }
    },
    {
      "name": "findByIdWithExpenses",
      "signature": "public abstract java.util.Optional<eu.nt.xpenses.models.Report> eu.nt.xpenses.repositories.ReportRepository.findByIdWithExpenses(long)",
      "query": {
        "query": "SELECT r FROM Report r LEFT JOIN FETCH r.expenses WHERE r.id = :id"
      }
